# Copier en .env.local (jamais versionné) ou définir chez l'hébergeur.
# Supabase : uniquement des valeurs PUBLIQUES, la sécurité repose sur RLS.
# Ne jamais mettre ici la clé secrète (sb_secret_…) ni la clé service_role.
#
# Project Settings > API Keys dans le tableau de bord Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Professeur IA (D-029) : variables SERVEUR, jamais préfixées NEXT_PUBLIC_ ---
# Laisser vide = mode sans IA générative (aucun appel, aucune dépense).
# Activer l'IA est une dépense : décision du porteur (Q-15). Il faut TOUT :
# fournisseur, clé, budget quotidien > 0. La clé se met chez l'hébergeur,
# jamais dans ce fichier versionné.
# KODI_TUTOR_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# KODI_TUTOR_DAILY_BUDGET_USD=0.50
# Facultatif (valeurs par défaut entre parenthèses) :
# KODI_TUTOR_MODEL=            (claude-opus-5-5 ; ou claude-haiku-5-5, moins cher)
# KODI_TUTOR_EFFORT=           (low)
# KODI_TUTOR_MAX_OUTPUT_TOKENS= (1500)
# KODI_TUTOR_PER_MINUTE=       (5 demandes par minute et par client)
# KODI_TUTOR_AI_PER_DAY=       (20 réponses IA par jour et par client)
# KODI_TUTOR_SERVER_FALLBACK=  (oui ; « non » pour désactiver le repli du fournisseur)
# KODI_TUTOR_PRICE_INPUT_USD= / KODI_TUTOR_PRICE_OUTPUT_USD= (tarifs par million de jetons, obligatoires pour un autre modèle)
# KODI_TUTOR_TIMEOUT_MS=       (30000)
# Quotas partagés entre plusieurs serveurs : SUPABASE_SECRET_KEY (voir Paiements) ;
# sans elle, compteurs en mémoire d'un seul serveur.

# --- Paiements Stripe (D-030, docs/PAIEMENTS.md) : variables SERVEUR ---
# Laisser vide = aucun paiement possible (affiché sur la page Premium).
# Commencer en mode TEST (clé sk_test_…). Une clé sk_live_… est refusée sauf
# KODI_BILLING_ALLOW_LIVE=oui ET prix confirmé ET informations du vendeur
# complètes dans le code. Ces valeurs se mettent chez l'hébergeur, jamais ici.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# KODI_SITE_URL=https://
# SUPABASE_SECRET_KEY=
# KODI_BILLING_ALLOW_LIVE=
