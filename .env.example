# Copier en .env.local (jamais versionné) ou définir chez l'hébergeur.
# Uniquement des valeurs PUBLIQUES : la sécurité repose sur RLS.
# Ne jamais mettre ici la clé secrète (sb_secret_…) ni la clé service_role.
#
# Project Settings > API Keys dans le tableau de bord Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
